# Neon Postgres — pooled connection, used by the running app (lib/db/client.ts)
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Neon Postgres — direct (non-pooled) connection, used only for drizzle-kit migrations
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# Neon API access, used by the test harness (test/setup) to create/delete an
# ephemeral branch per test run
NEON_API_KEY=""
NEON_PROJECT_ID=""

# Auth.js — signs/encrypts session JWTs. Generate with `openssl rand -base64 32`.
AUTH_SECRET=""

# Auth.js Google provider — OAuth client from the Google Cloud Console.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend — transactional email (lib/email/client.ts). API key from the Resend
# dashboard. Tests send to Resend's sandbox address (delivered@resend.dev),
# so this can be a key from a test/sandbox Resend account.
RESEND_API_KEY=""

# From-address used for all outgoing email. Must be on a domain verified with
# Resend (or "onboarding@resend.dev" for testing, which only delivers to the
# account owner's own address).
EMAIL_FROM=""

# Recipient for the admin new-Order notification email sent on checkout
# (lib/db/orders.ts).
ADMIN_EMAIL=""
